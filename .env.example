# Copy to .env for Docker Compose. Java reads process environment, not .env automatically.
POSTGRES_PASSWORD=
DASHSCOPE_API_KEY=
# Optional settings; defaults shown. TXT content is sent to DashScope for embeddings/answers.
POSTGRES_USER=knowflow
DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/knowflow
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=knowflow_m1_v1
UPLOAD_DIR=./data/uploads
SERVER_PORT=18080
